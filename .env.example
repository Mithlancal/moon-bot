# MoonBot Environment Configuration
# Get your free Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Recommended free-tier models: gemini-2.5-flash or gemini-2.0-flash
GEMINI_MODEL=gemini-2.5-flash

# Foreground window tracker polling interval in seconds (default: 2.0)
ACTIVITY_POLL_INTERVAL=2.0

# Focus Pomodoro default interval (in minutes)
POMODORO_WORK_MINUTES=25
POMODORO_BREAK_MINUTES=5

# UI Theme: dark / system
UI_THEME=dark
